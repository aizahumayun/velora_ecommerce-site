# Backend runtime configuration. Replace placeholders locally; never commit secrets.
PORT=3000
CORS_ORIGINS=https://your-actual-velora-domain.vercel.app
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/velora
MONGODB_DB_NAME=velora
JWT_SECRET=<replace-with-a-random-secret>
JWT_EXPIRES_IN=7d
CORS_ORIGINS=https://your-frontend.example.com
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password>
EMAIL_FROM=<sender-address>
